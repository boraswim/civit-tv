<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Loopback connection to the box's own adbd, used to switch launchers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Resets temporary classic mode back to ÇivitTV on every boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the launcher re-enable Apple Music's mouse mode if Android drops it. Granted via adb. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Lets the hold menu's "Kaldır" open Android's uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.apple.android.music" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="ÇivitTV"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Shows up as "ÇivitTV" in the stock launcher's app row; also opened by the "Classic Home" tile. -->
        <activity
            android:name=".SwitchActivity"
            android:exported="true"
            android:label="ÇivitTV"
            android:banner="@drawable/banner"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome.Switch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remote pointer for sideloaded phone apps (e.g. Apple Music). Enabled via adb. -->
        <service
            android:name=".MouseService"
            android:exported="true"
            android:label="@string/mouse_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mouse_service" />
        </service>

        <!-- Lets the home screen read what's playing (media sessions). Granted via adb. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="ÇivitTV"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lists the (phone-only) Apple Music app in the stock launcher with a TV banner. -->
        <activity
            android:name=".AppleMusicActivity"
            android:exported="true"
            android:label="Apple Music"
            android:banner="@drawable/banner_apple_music"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
